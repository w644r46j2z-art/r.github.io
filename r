<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday Nina!</title>
<link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@700&display=swap" rel="stylesheet">
<style>
:root{--bg:#cfe6f7;--ink:#a3304a;--btn:#e9707f;--btnink:#fff;--pill:rgba(255,255,255,.88);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a24;--pill:rgba(20,30,40,.88);--ink:#ffb3c0}}
:root[data-theme="dark"]{--bg:#0f1a24;--pill:rgba(20,30,40,.88);--ink:#ffb3c0}
html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;font-family:'Gaegu','Comic Sans MS',cursive,sans-serif}
body{display:flex;align-items:center;justify-content:center}
.stage{position:relative;width:min(100vw,calc(100dvh*.707));aspect-ratio:1414/2000;max-height:100%;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.25);user-select:none;-webkit-tap-highlight-color:transparent}
.sc{position:absolute;inset:0;background-size:100% 100%;opacity:0;pointer-events:none;transition:opacity .8s}
[data-s=cover] .s1,[data-s=env] .s2,[data-s=cake] .s4{opacity:1;pointer-events:auto}
.s1{background-image:url(data:image/jpeg;base64,)}.s2{background-image:url(data:image/jpeg;base64,)}.s4{background-image:url(data:image/jpeg;base64,)}
.btn{position:absolute;left:50%;transform:translateX(-50%);bottom:5%;z-index:9;border:0;border-radius:999px;background:var(--btn);color:var(--btnink);font:700 clamp(18px,4.6vw,30px)/1 'Gaegu',cursive;padding:.6em 1.3em;box-shadow:0 6px 18px rgba(0,0,0,.28);cursor:pointer;transition:transform .2s,opacity .5s}
.btn:active{transform:translateX(-50%) scale(.95)}
.btn.hide{opacity:0;pointer-events:none}
.pill{position:absolute;left:50%;transform:translateX(-50%);z-index:9;background:var(--pill);color:var(--ink);font:700 clamp(15px,3.8vw,24px) 'Gaegu',cursive;padding:.35em .9em;border-radius:999px;white-space:nowrap;transition:opacity .4s}
.hint{top:8%;animation:bob 1.6s ease-in-out infinite}
@keyframes bob{50%{transform:translateX(-50%) translateY(-6px)}}
.env{position:absolute;left:8%;top:25%;width:72%;height:48%;cursor:pointer;z-index:2}
.letter{position:absolute;inset:0;z-index:5;background:url(data:image/jpeg;base64,) 0 0/100% 100%;border-radius:2px;box-shadow:0 0 30px rgba(0,0,0,.3);opacity:0;pointer-events:none;transform:translateY(14%) scale(.5);transform-origin:45% 55%;transition:transform 1s cubic-bezier(.2,.8,.2,1),opacity .6s;cursor:pointer}
.letter.open{opacity:1;pointer-events:auto;transform:none}
.flame{position:absolute;width:4%;height:5.8%;top:39.4%;transform:translateX(-50%) rotate(var(--lean,0deg));transform-origin:50% 100%;transition:transform .12s,opacity .35s;cursor:pointer;z-index:4}
.flame i{position:absolute;inset:0;border-radius:50% 50% 50% 50%/62% 62% 38% 38%;background:radial-gradient(ellipse at 50% 75%,#fff7c2 0 22%,#ffd24a 45%,#ff8a1f 80%,rgba(255,120,30,0) 100%);filter:drop-shadow(0 0 10px #ffb347);transform-origin:50% 100%;animation:fl .35s ease-in-out infinite alternate}
.flame:nth-child(2) i{animation-duration:.43s}
@keyframes fl{0%{transform:scale(.92,1.05) skewX(-3deg)}100%{transform:scale(1.05,.93) skewX(4deg)}}
.flame.out{opacity:0;pointer-events:none}
.smoke{position:absolute;top:44%;width:3%;height:5%;border-radius:50%;background:radial-gradient(#fff9,#fff0 70%);transform:translateX(-50%);opacity:0;z-index:4}
.smoke.go{animation:sm 2s ease-out forwards}
@keyframes sm{0%{opacity:.9;transform:translate(-50%,0) scale(.5)}100%{opacity:0;transform:translate(-30%,-900%) scale(3)}}
.msg{position:absolute;left:0;right:0;top:33%;text-align:center;z-index:8;color:var(--ink);font:700 clamp(26px,7.5vw,54px)/1.05 'Gaegu',cursive;text-shadow:0 2px 0 #fff,0 0 18px #fff;opacity:0;transform:scale(.6);transition:all .7s cubic-bezier(.2,1.4,.4,1);pointer-events:none}
.msg.show{opacity:1;transform:none}
canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:7}
.cakebtns{position:absolute;left:0;right:0;bottom:4%;display:flex;justify-content:center;gap:10px;z-index:9}
.cakebtns .btn{position:static;transform:none;font-size:clamp(13px,3.2vw,20px);padding:.45em 1em}
.s1 .btn{left:auto;right:3%;bottom:2.5%;transform:none;font-size:clamp(12px,2.8vw,18px);line-height:1.05;padding:.5em .9em;text-align:center}
.s1 .btn:active{transform:scale(.95)}
.s2 .btn{left:auto;right:3%;bottom:1%;transform:none;font-size:clamp(11px,2.5vw,16px);padding:.4em .9em;white-space:nowrap}
.s2 .btn:active{transform:scale(.95)}
</style></head>
<body><main class="stage" id="st" data-s="cover">
<section class="sc s1"><button class="btn" id="open">Open your<br>card</button></section>
<section class="sc s2">
 <div class="pill hint" id="hint">Tap the envelope</div>
 <div class="env" id="env" role="button" aria-label="Open the envelope"></div>
 <div class="letter" id="letter" role="button" aria-label="Letter, tap to close"></div>
 <button class="btn hide" id="light">Light the candles</button>
</section>
<section class="sc s4" id="cake">
 <div class="flame" id="f1" style="left:34.4%"><i></i></div>
 <div class="flame" id="f2" style="left:63.6%"><i></i></div>
 <div class="smoke" id="sm1" style="left:34.4%"></div><div class="smoke" id="sm2" style="left:63.6%"></div>
 <div class="msg" id="msg">Happy birthday, Nina!</div>
 <div class="pill" id="status" style="top:3%"></div>
 <canvas id="cv"></canvas>
 <div class="cakebtns"><button class="btn" id="mic">Blow with my mic</button><button class="btn hide" id="relight">Relight</button></div>
</section>
</main>
<script>
const $=id=>document.getElementById(id),st=$('st');
let opened=false;
$('open').onclick=()=>st.dataset.s='env';
const toggle=()=>{const l=$('letter');l.classList.toggle('open');if(l.classList.contains('open')){opened=true;$('hint').style.opacity=0;$('light').classList.remove('hide')}};
$('env').onclick=toggle;$('letter').onclick=toggle;
$('light').onclick=()=>{$('letter').classList.remove('open');st.dataset.s='cake';setTimeout(()=>$('light').classList.add('hide'),800);status('Tap the button, then blow on the candles')};
const fl=[$('f1'),$('f2')],sm=[$('sm1'),$('sm2')];let out=[false,false];
function status(t){const s=$('status');s.textContent=t;s.style.opacity=t?1:0}
function snuff(i){if(out[i])return;out[i]=true;fl[i].classList.add('out');sm[i].classList.remove('go');void sm[i].offsetWidth;sm[i].classList.add('go');if(out[0]&&out[1])win()}
fl.forEach((f,i)=>f.onclick=()=>snuff(i));
function lean(v){fl.forEach(f=>f.style.setProperty('--lean',(v*38)+'deg'))}
let ac,stream,raf,listening=false;
async function startMic(){
 try{
  stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});
  ac=new (window.AudioContext||window.webkitAudioContext)();await ac.resume();
  const an=ac.createAnalyser();an.fftSize=1024;ac.createMediaStreamSource(stream).connect(an);
  const d=new Float32Array(an.fftSize),rms=()=>{an.getFloatTimeDomainData(d);let s=0;for(const x of d)s+=x*x;return Math.sqrt(s/d.length)};
  $('mic').classList.add('hide');status('Getting ready… stay quiet for a second');
  let base=0,n=0;const t0=performance.now();
  await new Promise(r=>{const c=()=>{base+=rms();n++;performance.now()-t0<700?setTimeout(c,30):r()};c()});
  base/=n;listening=true;status('Now blow on the candles!');
  let pw=0,last=performance.now(),sm_=0;
  const loop=now=>{if(!listening)return;const dt=(now-last)/1000;last=now;
   const r=rms(),thr=Math.max(base*2.4,base+.045),blow=r>thr;
   const amt=blow?Math.min(1,(r-thr)/.12+.35):0;sm_+=(amt-sm_)*.25;lean(sm_);
   pw=Math.max(0,pw+(blow?dt:-dt*.5));
   if(!out[0]&&pw>.6)snuff(0);if(!out[1]&&pw>1.3)snuff(1);
   if(out[0]&&out[1]){stop();return}raf=requestAnimationFrame(loop)};
  raf=requestAnimationFrame(loop);
 }catch(e){status('Mic not available, tap the flames to blow them out');$('mic').classList.add('hide')}
}
function stop(){listening=false;cancelAnimationFrame(raf);lean(0);stream&&stream.getTracks().forEach(t=>t.stop());ac&&ac.close().catch(()=>{})}
$('mic').onclick=startMic;
function win(){stop();status('');lean(0);setTimeout(()=>{$('msg').classList.add('show');confetti();$('relight').classList.remove('hide')},500)}
$('relight').onclick=()=>{out=[false,false];fl.forEach(f=>f.classList.remove('out'));sm.forEach(s=>s.classList.remove('go'));$('msg').classList.remove('show');$('relight').classList.add('hide');$('mic').classList.remove('hide');status('Tap the button, then blow on the candles')};
function confetti(){
 const c=$('cv'),x=c.getContext('2d'),W=c.width=c.clientWidth*devicePixelRatio,H=c.height=c.clientHeight*devicePixelRatio;
 const col=['#e9707f','#ffd24a','#7cc4f0','#9ccc65','#f7a8b8','#fff'];
 const p=Array.from({length:170},()=>({x:W/2+(Math.random()-.5)*W*.3,y:H*.45,vx:(Math.random()-.5)*W*.02,vy:-Math.random()*H*.014-H*.004,s:(6+Math.random()*8)*devicePixelRatio,r:Math.random()*6,vr:(Math.random()-.5)*.3,c:col[Math.random()*col.length|0]}));
 let f=0;(function a(){x.clearRect(0,0,W,H);p.forEach(q=>{q.vy+=H*.00045;q.x+=q.vx;q.y+=q.vy;q.r+=q.vr;x.save();x.translate(q.x,q.y);x.rotate(q.r);x.fillStyle=q.c;x.fillRect(-q.s/2,-q.s/4,q.s,q.s/2);x.restore()});
  if(++f<260)requestAnimationFrame(a);else x.clearRect(0,0,W,H)})();
}
</script></body></html>
